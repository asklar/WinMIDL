namespace TestApp.Parity
{
    enum Alignment
    {
        Left = 0,
        Center = 1,
        Right = 2
    };

    enum Visibility
    {
        Visible = 0,
        Hidden = 1,
        Collapsed = 2
    };

    struct LayoutInfo
    {
        Alignment HorizontalAlignment;
        Alignment VerticalAlignment;
        Visibility ElementVisibility;
        Double Width;
        Double Height;
        Int32 ZIndex;
    };

    runtimeclass LayoutWidget
    {
        LayoutWidget();
        LayoutInfo GetLayout();
        void SetLayout(LayoutInfo layout);
    }
}
