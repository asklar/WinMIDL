namespace TestApp
{
    [contractversion(2)]
    apicontract TestContract {};

    [contract(TestApp.TestContract, 1)]
    runtimeclass VersionedClass
    {
        VersionedClass();
        String Name { get; };

        [contract(TestApp.TestContract, 2)]
        {
            void NewMethod();
            Boolean NewProperty { get; };
        }
    }
}
