namespace TestApp
{
    delegate void StatusHandler(Int32 code, String message);

    runtimeclass FullClass
    {
        FullClass();
        FullClass(String name);
        FullClass(String name, Int32 count);

        String Name { get; };
        Int32 Count;
        Boolean IsEnabled { get; set; };

        void DoWork();
        String Transform(String input);
        static Int32 GetInstanceCount();

        event StatusHandler StatusChanged;
    }
}
