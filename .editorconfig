root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_size = 4

[*.{cpp,cxx,cc,h,hpp,c}]
indent_size = 4

[*.{ts,js,json,jsonc}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.{ps1,psm1,psd1}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
