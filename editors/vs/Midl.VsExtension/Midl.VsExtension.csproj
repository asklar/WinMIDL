<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows8.0</TargetFramework>
    <IsExperimentalExtension>true</IsExperimentalExtension>
    <RootNamespace>Midl.VsExtension</RootNamespace>
    <NoWarn>$(NoWarn);VSEXTPREVIEW_LSP;VSEXTPREVIEW_SETTINGS;CEE0027</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Midl.VsExtension.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.14.40608" />
    <PackageReference Include="Nerdbank.Streams" Version="2.12.87" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="midl.tmLanguage.json" LogicalName="midl.tmLanguage.json" />
    <EmbeddedResource Include="snippets.json" LogicalName="snippets.json" />
  </ItemGroup>

  <!-- Copy server binary into extension output when available -->
  <Target Name="BundleServerBinary" AfterTargets="Build" Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\publish\win-x64\Midl.Cli.exe')">
    <MakeDir Directories="$(OutputPath)server\win-x64" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\..\publish\win-x64\Midl.Cli.exe"
          DestinationFolder="$(OutputPath)server\win-x64"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
