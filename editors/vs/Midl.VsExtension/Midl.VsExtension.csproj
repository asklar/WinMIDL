<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProjectGuid>{B86D8FE3-55D1-4B94-A626-2A76B4D86567}</ProjectGuid>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <NoWarn>CS8612;CS8613;CS8618;CS8600;CS8603;CS8625;CS0649;VSSDK007</NoWarn>
    <!-- VS 17 build tools need this hook; automatic SDK-style VSIX setup starts with VS 18.5. -->
    <CustomAfterMicrosoftCSharpTargets>$(VsSDKInstall)\Microsoft.VsSDK.targets</CustomAfterMicrosoftCSharpTargets>
    <CreateVsixContainer>true</CreateVsixContainer>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <StartAction>Program</StartAction>
    <StartProgram Condition="'$(DevEnvDir)' != ''">$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
  </PropertyGroup>
  <ItemGroup>
    <ProjectCapability Include="CreateVsixContainer" />
  </ItemGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Update="MidlOptionsPage.cs">
      <SubType>Component</SubType>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <None Remove="TextMate.pkgdef;icon.png;snippets.json;server\win-arm64\Midl.Cli.exe" />
  </ItemGroup>
  <ItemGroup>
    <VSCTCompile Include="MidlCommandTable.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\vscode\syntaxes\midl.tmLanguage.json" Link="midl.tmLanguage.json">
      <IncludeInVSIX>true</IncludeInVSIX>
      <TargetPath>midl.tmLanguage.json</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\vscode\language-configuration.json" Link="language-configuration.json">
      <IncludeInVSIX>true</IncludeInVSIX>
      <TargetPath>language-configuration.json</TargetPath>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="TextMate.pkgdef">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="icon.png">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="snippets.json">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- The win-x64 server binary is registered dynamically by the BundleServerBinary target below so it
         is included even on a clean build (see that target for why a static item is unreliable here). -->
    <Content Include="server\win-arm64\Midl.Cli.exe" Condition="Exists('server\win-arm64\Midl.Cli.exe')">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Design" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" NoWarn="NU1604" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2120" PrivateAssets="all" NoWarn="NU1604" />
    <PackageReference Include="Microsoft.VisualStudio.LanguageServer.Client" Version="17.14.60" NoWarn="NU1604" />
    <!-- Keep the VS 17.14 SDK's StreamJsonRpc dependency above the language client's lower bound. -->
    <PackageReference Include="StreamJsonRpc" Version="2.22.11" />
  </ItemGroup>
  <!-- Stage the published server binary into the project tree and include it in the VSIX and build
       output. The Content item is registered inside this target (rather than as a static item) so it is
       present even on a clean build: a static item's Exists condition is evaluated before this target
       copies the file, which previously left Midl.Cli.exe out of experimental deployments. Always is used
       so a freshly published binary is redeployed every build. -->
  <Target Name="BundleServerBinary"
          BeforeTargets="AssignTargetPaths;GetVsixSourceItems"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\publish\win-x64\Midl.Cli.exe')">
    <MakeDir Directories="$(MSBuildThisFileDirectory)server\win-x64" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\..\publish\win-x64\Midl.Cli.exe"
          DestinationFolder="$(MSBuildThisFileDirectory)server\win-x64"
          SkipUnchangedFiles="false"
          OverwriteReadOnlyFiles="true" />
    <ItemGroup>
      <Content Include="server\win-x64\Midl.Cli.exe">
        <IncludeInVSIX>true</IncludeInVSIX>
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
  </Target>
</Project>
