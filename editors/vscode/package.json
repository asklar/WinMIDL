{
  "name": "midl3-language-server",
  "displayName": "MIDL Language Support",
  "description": "Full-featured IDE for WinRT Interface Definition Language — real-time diagnostics, smart autocomplete, go-to-definition, code actions, WinMD output, and more.",
  "version": "0.1.1",
  "publisher": "AlexanderSklarMSFT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/asklar/midl-langserv"
  },
  "icon": "images/icon.png",
  "keywords": [
    "MIDL",
    "IDL",
    "WinRT",
    "MIDL3",
    "Windows Runtime",
    "WinMD",
    "Language Server"
  ],
  "contributes": {
    "languages": [
      {
        "id": "midl",
        "aliases": [
          "MIDL",
          "midl",
          "IDL",
          "MIDL3"
        ],
        "extensions": [
          ".idl"
        ],
        "firstLine": "^\\s*(namespace|import|\\[|runtimeclass|interface|delegate|struct|enum|//)",
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "midl",
        "scopeName": "source.midl",
        "path": "./syntaxes/midl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "midl",
        "path": "./snippets/midl.json"
      }
    ],
    "commands": [
      {
        "command": "midl.toggleStrictMode",
        "title": "MIDL: Toggle Strict MIDL3 Mode"
      },
      {
        "command": "midl.restartServer",
        "title": "MIDL: Restart Language Server"
      },
      {
        "command": "midl.showServerLog",
        "title": "MIDL: Show Language Server Output"
      },
      {
        "command": "midl.selectSdkVersion",
        "title": "MIDL: Select Windows SDK Version"
      }
    ],
    "configurationDefaults": {
      "editor.semanticTokenColorCustomizations": {
        "[*]": {
          "rules": {
            "decorator:midl": {
              "foreground": "#C586C0",
              "fontStyle": "bold"
            }
          }
        }
      }
    },
    "configuration": {
      "title": "MIDL",
      "properties": {
        "midl.serverPath": {
          "type": "string",
          "default": "midl",
          "description": "Path to the MIDL CLI executable for the language server."
        },
        "midl.strictMode": {
          "type": "boolean",
          "default": true,
          "description": "Enable strict MIDL3 mode. When enabled, classic MIDL constructs (coclass, library, typedef, etc.) produce warnings. Disable for mixed MIDL2/MIDL3 codebases."
        },
        "midl.codeQualityHints": {
          "type": "boolean",
          "default": true,
          "description": "Show code quality hints (naming conventions, empty types, etc.)"
        },
        "midl.useWindowsSdk": {
          "type": "boolean",
          "default": true,
          "description": "Automatically reference Windows.winmd from the installed Windows SDK for type completion and F12 navigation.",
          "order": 3
        },
        "midl.windowsSdkVersion": {
          "type": "string",
          "default": "latest",
          "markdownDescription": "Windows SDK version to use. Use the **MIDL: Select Windows SDK Version** command to pick from installed versions.",
          "order": 4
        },
        "midl.flatSdkTypeCompletions": {
          "type": "boolean",
          "default": false,
          "description": "Show all SDK types by short name in completions (e.g. 'Button', 'Control'). When off, only SDK namespace names appear and you drill in with dot notation."
        },
        "midl.fetchSdkDocs": {
          "type": "boolean",
          "default": true,
          "description": "Fetch type descriptions from Microsoft Learn on hover. Requires internet access."
        },
        "midl.inlineDocsBrowser": {
          "type": "boolean",
          "default": true,
          "description": "Open Microsoft Learn documentation in a VS Code side panel instead of the external browser."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "bundle": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify",
    "watch": "tsc -watch -p .",
    "vscode:prepublish": "npm run bundle",
    "package": "npx @vscode/vsce package"
  },
  "main": "./out/extension.js",
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.27.4",
    "typescript": "^5.3.0"
  }
}
