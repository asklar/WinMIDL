{
  "name": "midl3-language-server",
  "displayName": "MIDL Language Support",
  "description": "Full-featured IDE for WinRT Interface Definition Language — real-time diagnostics, smart autocomplete, go-to-definition, code actions, WinMD output, and more.",
  "version": "0.1.0",
  "publisher": "AlexanderSklarMSFT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/asklar/WinMIDL"
  },
  "icon": "images/icon.png",
  "keywords": [
    "MIDL",
    "IDL",
    "WinRT",
    "MIDL3",
    "Windows Runtime",
    "WinMD",
    "Language Server"
  ],
  "contributes": {
    "languages": [
      {
        "id": "midl",
        "aliases": [
          "MIDL",
          "midl",
          "IDL",
          "MIDL3"
        ],
        "extensions": [
          ".idl"
        ],
        "firstLine": "^\\s*(namespace|import|\\[|runtimeclass|interface|delegate|struct|enum|//)",
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "midl",
        "scopeName": "source.midl",
        "path": "./syntaxes/midl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "midl",
        "path": "./snippets/midl.json"
      }
    ],
    "commands": [
      {
        "command": "midl.toggleStrictMode",
        "title": "MIDL: Toggle Strict MIDL3 Mode"
      },
      {
        "command": "midl.restartServer",
        "title": "MIDL: Restart Language Server"
      },
      {
        "command": "midl.showServerLog",
        "title": "MIDL: Show Language Server Output"
      }
    ],
    "configurationDefaults": {
      "editor.semanticTokenColorCustomizations": {
        "[*]": {
          "rules": {
            "decorator:midl": {
              "foreground": "#C586C0",
              "fontStyle": "bold"
            }
          }
        }
      }
    },
    "configuration": {
      "title": "MIDL",
      "properties": {
        "midl.serverPath": {
          "type": "string",
          "default": "midl",
          "description": "Path to the MIDL CLI executable for the language server."
        },
        "midl.strictMode": {
          "type": "boolean",
          "default": true,
          "description": "Enable strict MIDL3 mode. When enabled, classic MIDL constructs (coclass, library, typedef, etc.) produce warnings. Disable for mixed MIDL2/MIDL3 codebases."
        },
        "midl.codeQualityHints": {
          "type": "boolean",
          "default": true,
          "description": "Show code quality hints (naming conventions, empty types, etc.)"
        },
        "midl.useWindowsSdk": {
          "type": "boolean",
          "default": true,
          "description": "Automatically reference Windows.winmd from the installed Windows SDK for type completion and F12 navigation."
        },
        "midl.windowsSdkVersion": {
          "type": "string",
          "default": "latest",
          "description": "Windows SDK version to use (e.g. '10.0.26100.0'). Set to 'latest' to auto-detect the newest installed version.",
          "examples": ["latest", "10.0.26100.0", "10.0.22621.0"]
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "bundle": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify",
    "watch": "tsc -watch -p .",
    "vscode:prepublish": "npm run bundle",
    "package": "npx @vscode/vsce package"
  },
  "main": "./out/extension.js",
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.27.4",
    "typescript": "^5.3.0"
  }
}
