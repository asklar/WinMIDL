{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-extension",
            "type": "npm",
            "script": "compile",
            "group": "build",
            "problemMatcher": "$tsc"
        },
        {
            "label": "watch-extension",
            "type": "npm",
            "script": "watch",
            "isBackground": true,
            "group": "build",
            "problemMatcher": "$tsc-watch"
        },
        {
            "label": "build-server",
            "type": "shell",
            "command": "dotnet",
            "args": ["build", "--no-restore", "${workspaceFolder}/../../src/Midl.Cli/Midl.Cli.csproj"],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-all",
            "dependsOn": ["build-server", "build-extension"],
            "dependsOrder": "parallel",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
