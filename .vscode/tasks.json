{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-extension",
            "type": "shell",
            "command": "cd editors/vscode && npm run compile",
            "group": "build",
            "problemMatcher": "$tsc"
        },
        {
            "label": "build-all",
            "type": "shell",
            "command": "dotnet build && cd editors/vscode && npm run compile",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$msCompile", "$tsc"]
        },
        {
            "label": "test",
            "type": "shell",
            "command": "dotnet test",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        }
    ]
}
