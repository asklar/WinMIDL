<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Midl.Syntax\Midl.Syntax.csproj" />
    <ProjectReference Include="..\Midl.Lexer\Midl.Lexer.csproj" />
    <ProjectReference Include="..\Midl.Parser\Midl.Parser.csproj" />
    <ProjectReference Include="..\Midl.Analysis\Midl.Analysis.csproj" />
    <ProjectReference Include="..\Midl.CodeGen\Midl.CodeGen.csproj" />
    <ProjectReference Include="..\Midl.Lsp\Midl.Lsp.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <!-- SelfContained + SingleFile only during publish, not during build -->
  <PropertyGroup Condition="'$(PublishAot)' != 'true' and '$(IsPublishing)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

</Project>
