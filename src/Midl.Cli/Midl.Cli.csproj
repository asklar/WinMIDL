<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Midl.Syntax\Midl.Syntax.csproj" />
    <ProjectReference Include="..\Midl.Lexer\Midl.Lexer.csproj" />
    <ProjectReference Include="..\Midl.Parser\Midl.Parser.csproj" />
    <ProjectReference Include="..\Midl.Analysis\Midl.Analysis.csproj" />
    <ProjectReference Include="..\Midl.CodeGen\Midl.CodeGen.csproj" />
    <ProjectReference Include="..\Midl.Lsp\Midl.Lsp.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Midl.Cli</AssemblyName>
    <Product>WinMIDL</Product>
    <Description>WinRT MIDL3 compiler — diagnostics, WinMD generation, header/proxy codegen, LSP server</Description>
    <Copyright>Copyright (c) Microsoft Corporation</Copyright>
    <!-- Version set via /p:Version= from CI/CD or defaults to dev version -->
    <Version Condition="'$(Version)' == ''">0.1.0-dev</Version>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">0.1.0.0</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">0.1.0.0</FileVersion>

    <!-- dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>winmidl</ToolCommandName>
    <PackageId>WinMIDL</PackageId>
    <Authors>Microsoft Corporation</Authors>
    <PackageProjectUrl>https://github.com/microsoft/midl</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>midl;idl;winrt;winmd;compiler;language-server</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/microsoft/midl</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <OptimizationPreference>Speed</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StackTraceSupport>false</StackTraceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- SelfContained + SingleFile only during publish, not during build -->
  <PropertyGroup Condition="'$(PublishAot)' != 'true' and '$(IsPublishing)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <!-- Embed proxy runtime headers as resources -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\include\winmidl\proxy_helpers.h" LogicalName="winmidl.proxy_helpers.h" />
    <EmbeddedResource Include="..\..\include\winmidl\wil_compat.h" LogicalName="winmidl.wil_compat.h" />
  </ItemGroup>

  <!-- Package README for NuGet -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>


